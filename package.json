{
  "name": "deepseek-harness-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "tauri": "tauri",
    "runtime:node": "node scripts/download-node.ts",
    "runtime:harness": "node scripts/prepare-harness.ts",
    "runtime:sidecar": "node scripts/build-sidecar.ts",
    "runtime:all": "node scripts/download-node.ts && node scripts/prepare-harness.ts && node scripts/build-sidecar.ts",
    "runtime:verify": "node scripts/verify-runtime.ts",
    "release:preflight": "node scripts/release-preflight.ts",
    "icons": "node scripts/gen-icon.ts && tauri icon src-tauri/icons/icon-source.png --output src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@11.21.0"
}
